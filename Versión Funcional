<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VibeWeb Pro | Tu Herramienta de Diseño y Desarrollo Web</title>
  <link rel="stylesheet" href="css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container">
      <div class="logo">
        <h1>VibeWeb <span>Pro</span></h1>
      </div>
      <nav class="nav">
        <a href="#inicio" class="active">Inicio</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#diseno">Diseño</a>
        <a href="#desarrollo">Desarrollo</a>
        <a href="#tendencias">Tendencias</a>
        <a href="#ia">IA</a>
      </nav>
      <div class="user-actions">
        <button class="btn btn-secondary">🔍 Buscar</button>
        <button class="btn btn-primary">👤 Mi Cuenta</button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="inicio" class="hero">
    <div class="container">
      <div class="hero-content">
        <h2>Tu <span>brazo derecho</span> para crear páginas web profesionales</h2>
        <p>Diseña, desarrolla y optimiza con la ayuda de IA, tendencias en tiempo real y herramientas poderosas.</p>
        <div class="hero-buttons">
          <button class="btn btn-primary">🚀 Empezar Proyecto</button>
          <button class="btn btn-secondary">🎨 Explorar Plantillas</button>
        </div>
      </div>
      <div class="hero-image">
        <div class="mockup-dashboard">
          <div class="mockup-sidebar"></div>
          <div class="mockup-main">
            <div class="mockup-header"></div>
            <div class="mockup-content">
              <div class="mockup-card"></div>
              <div class="mockup-card"></div>
              <div class="mockup-card"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Proyectos -->
  <section id="proyectos" class="section">
    <div class="container">
      <h2 class="section-title">📌 Tus Proyectos</h2>
      <div class="projects-grid">
        <div class="project-card">
          <div class="project-image" style="background: linear-gradient(135deg, #FF2D75, #FFD700);"></div>
          <h3>Landing Fotografía</h3>
          <p>Última edición: Hoy</p>
          <div class="project-actions">
            <button class="btn-icon">✏️</button>
            <button class="btn-icon">🗑️</button>
          </div>
        </div>
        <div class="project-card">
          <div class="project-image" style="background: linear-gradient(135deg, #00F5FF, #8A2BE2);"></div>
          <h3>E-commerce Moda</h3>
          <p>Última edición: Ayer</p>
          <div class="project-actions">
            <button class="btn-icon">✏️</button>
            <button class="btn-icon">🗑️</button>
          </div>
        </div>
        <div class="project-card new-project">
          <div class="add-project">
            <span>+</span>
            <p>Nuevo Proyecto</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Diseño -->
  <section id="diseno" class="section">
    <div class="container">
      <h2 class="section-title">🎨 Herramientas de Diseño</h2>
      <div class="tools-grid">
        <div class="tool-card">
          <div class="tool-icon" style="background: #FF2D75;">🎨</div>
          <h3>Generar Paleta</h3>
          <p>Crea combinaciones de colores basadas en tendencias 2026.</p>
          <button class="btn btn-small">Probar</button>
        </div>
        <div class="tool-card">
          <div class="tool-icon" style="background: #00F5FF;">🔤</div>
          <h3>Tipografías</h3>
          <p>Selecciona fuentes modernas y combinaciones perfectas.</p>
          <button class="btn btn-small">Probar</button>
        </div>
        <div class="tool-card">
          <div class="tool-icon" style="background: #FFD700;">📐</div>
          <h3>Layouts</h3>
          <p>Elige entre Bento Grid, Scroll Storytelling y más.</p>
          <button class="btn btn-small">Probar</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Desarrollo -->
  <section id="desarrollo" class="section">
    <div class="container">
      <h2 class="section-title">💻 Herramientas de Desarrollo</h2>
      <div class="tools-grid">
        <div class="tool-card">
          <div class="tool-icon" style="background: #8A2BE2;">&lt;/&gt;</div>
          <h3>Editor de Código</h3>
          <p>Edita HTML, CSS y JS en tiempo real.</p>
          <button class="btn btn-small">Abrir</button>
        </div>
        <div class="tool-card">
          <div class="tool-icon" style="background: #32CD32;">🧩</div>
          <h3>Componentes</h3>
          <p>Genera botones, tarjetas y formularios con estilos 2026.</p>
          <button class="btn btn-small">Abrir</button>
        </div>
        <div class="tool-card">
          <div class="tool-icon" style="background: #FF6347;">🐞</div>
          <h3>Depurador</h3>
          <p>Revisa y optimiza tu código con IA.</p>
          <button class="btn btn-small">Abrir</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de Tendencias -->
  <section id="tendencias" class="section">
    <div class="container">
      <h2 class="section-title">📊 Tendencias 2026</h2>
      <div class="trends-grid">
        <div class="trend-card">
          <div class="trend-image" style="background: linear-gradient(135deg, #FF2D75, #00F5FF);"></div>
          <h3>Bento Grid</h3>
          <p>Layouts modulares y asimétricos para contenido visual.</p>
          <button class="btn btn-small">Ver Ejemplo</button>
        </div>
        <div class="trend-card">
          <div class="trend-image" style="background: linear-gradient(135deg, #FFD700, #FF6347);"></div>
          <h3>Neón + Serif</h3>
          <p>Combinación de colores vibrantes con tipografías elegantes.</p>
          <button class="btn btn-small">Ver Ejemplo</button>
        </div>
        <div class="trend-card">
          <div class="trend-image" style="background: linear-gradient(135deg, #8A2BE2, #32CD32);"></div>
          <h3>3D Inmersivo</h3>
          <p>Elementos 3D interactivos con WebGL.</p>
          <button class="btn btn-small">Ver Ejemplo</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección de IA -->
  <section id="ia" class="section">
    <div class="container">
      <h2 class="section-title">🤖 Asistente de IA</h2>
      <div class="ai-assistant">
        <div class="ai-chat">
          <div class="ai-message">
            <p>Hola Sergio, ¿en qué puedo ayudarte hoy?</p>
          </div>
          <div class="ai-input">
            <input type="text" placeholder="Pregúntame sobre diseño, código, SEO...">
            <button class="btn btn-primary">Enviar</button>
          </div>
        </div>
        <div class="ai-features">
          <div class="feature-card">
            <h4>🎨 Diseño</h4>
            <p>Sugerencias de estilos, paletas y layouts.</p>
          </div>
          <div class="feature-card">
            <h4>💻 Código</h4>
            <p>Generación y optimización de código.</p>
          </div>
          <div class="feature-card">
            <h4>📈 SEO</h4>
            <p>Recomendaciones para posicionamiento.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-logo">
          <h3>VibeWeb Pro</h3>
          <p>Tu herramienta definitiva para diseño y desarrollo web.</p>
        </div>
        <div class="footer-links">
          <a href="#">Acerca de</a>
          <a href="#">Documentación</a>
          <a href="#">Contacto</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 VibeWeb Pro. Todos los derechos reservados.</p>
      </div>
    </div>
  </footer>

  <script src="js/app.js"></script>
</body>
</html>
