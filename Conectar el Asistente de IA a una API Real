async function callMistralAPI(prompt) {
  const response = await fetch("https://api.mistral.ai/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": `Bearer TU_API_KEY`,
    },
    body: JSON.stringify({
      model: "mistral-medium",
      messages: [{ role: "user", content: prompt }],
    }),
  });
  const data = await response.json();
  return data.choices[0].message.content;
}

// Modifica el evento del botón de IA:
document.querySelector('.ai-input button').addEventListener('click', async (e) => {
  e.preventDefault();
  const input = document.querySelector('.ai-input input');
  const chat = document.querySelector('.ai-chat');

  if (input.value.trim() !== '') {
    const userMessage = document.createElement('div');
    userMessage.className = 'ai-message user';
    userMessage.innerHTML = `<p>${input.value}</p>`;
    chat.insertBefore(userMessage, chat.lastChild);

    const response = await callMistralAPI(input.value);
    const aiResponse = document.createElement('div');
    aiResponse.className = 'ai-message';
    aiResponse.innerHTML = `<p>${response}</p>`;
    chat.insertBefore(aiResponse, chat.lastChild);
    input.value = '';
  }
});
